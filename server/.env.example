# Server environment variables example
# Copy this to .env in the server folder and replace values for production

PORT=5001
NODE_ENV=development

# MongoDB connection string (use Atlas or your managed Mongo in production)
MONGO_URI=mongodb://localhost:27017/mini-dmart

# JWT config
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d

# Seed admin credentials used by seedAdmin.js (change for production)
ADMIN_EMAIL=admin@minidmart.com
ADMIN_PASSWORD=Admin@123

# Optional: CORS allowed origin for the frontend (set to your deployed frontend URL)
# Example: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: Email/send notifications (if configured)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
